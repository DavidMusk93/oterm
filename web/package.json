{
  "name": "oterm-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --sourcemap --format=esm --outfile=dist/app.js && cp index.html dist/index.html && cp src/styles.css dist/styles.css && cp node_modules/@xterm/xterm/css/xterm.css dist/xterm.css",
    "dev": "esbuild src/main.ts --bundle --sourcemap --format=esm --outfile=dist/app.js --watch"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
